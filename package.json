{
  "name": "dailyrepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test --runInBand",
    "dev:web": "pnpm --filter @dailyrepo/web dev",
    "dev:api": "pnpm --filter @dailyrepo/api dev",
    "jobs:daily": "pnpm --filter @dailyrepo/jobs daily",
    "jobs:weekly": "pnpm --filter @dailyrepo/jobs weekly",
    "jobs:schedule": "pnpm --filter @dailyrepo/jobs schedule",
    "scrape": "pnpm --filter @dailyrepo/scraper scrape:batched"
  }
}
