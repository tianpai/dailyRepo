{
  "name": "@dailyrepo/jobs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "daily": "node dist/main.js daily",
    "weekly": "node dist/main.js weekly",
    "schedule": "node dist/main.js schedule",
    "test": "jest"
  },
  "dependencies": {
    "@dailyrepo/database": "workspace:*",
    "@huggingface/inference": "4.13.32",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/schedule": "6.1.3",
    "mongoose": "8.24.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
